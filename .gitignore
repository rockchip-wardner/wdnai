# ============================================================================ #
# Project-specific: huge RKNN model files
# (each .rknn/.weight/.bin is hundreds of MB to 2.4 GB; never commit them)
# ============================================================================ #
rkai/models/**/*.rknn
rkai/models/**/*.weight
rkai/models/**/*.bin
rkai/models/**/*.gguf

# Keep the directory itself + README
!rkai/models/README.md
!rkai/models/.gitkeep

# ============================================================================ #
# Test / demo data
# ============================================================================ #
test.jpg
test.png
test.mp4
R-C.png
*.tmp
.cache/

# LocateAnything demo runtime output (regenerated on every run of
# examples/locate_image.py; not a source artifact).
examples/locate_anything_vis.jpg

# Depth Anything V3 demo runtime output — the sample's default --output-dir
# is "depth_vis" **relative to cwd**, so running it from inside examples/
# drops the heatmaps here. Regenerated on every run; not a source artifact.
examples/depth_vis/

# ============================================================================ #
# Test / coverage artifacts
# ============================================================================ #
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

